 python3 << 'PYEOF'
import pandas as pd
from pathlib import Path

assets = ['EURUSD', 'GBPUSD', 'EURAUD', 'EURJPY', 'NZDUSD', 'GOLD']
results_dir = Path('results')

print("\n📊 ANÁLISE RÁPIDA - 6 ATIVOS\n")
print(f"{'ATIVO':<10} {'LINHAS':>8} {'SINAIS':>8} {'POS':>8} {'NEG':>8} {'WR%':>8}")
print("-" * 60)

for asset in assets:
    csv_file = results_dir / f'backtest_{asset}_DETAILED.csv'
    if csv_file.exists():
        df = pd.read_csv(csv_file)
        total = len(df)
        pos_pips = (df['actual_pips'] > 0).sum()
        neg_pips = (df['actual_pips'] <= 0).sum()
        wr = (pos_pips / total * 100) if total > 0 else 0
        print(f"{asset:<10} {total:>8} {total:>8} {pos_pips:>8} {neg_pips:>8} {wr:>7.1f}%")

print("\n✅ Análise completa")
PYEOF

